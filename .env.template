# Copy to .env.production (production) or .env.pre (staging, `pnpm build:pre`) and fill in.
# In CI/hosting, set the same variables in the platform instead of committing files.

# Public URL of the deployed site, no trailing slash. Used for canonical URLs, Open Graph, sitemap and JSON-LD.
SITE_URL=https://example.com

# "production" allows indexing. Anything else (or unset) renders noindex and a blocking robots.txt.
SITE_ENV=staging

# Optional: search console ownership verification tokens (content value of the meta tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
