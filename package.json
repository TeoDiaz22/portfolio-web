{
    "name": "portfolio-web",
    "type": "module",
    "version": "0.0.1",
    "private": true,
    "packageManager": "pnpm@12.16.1",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "build:pre": "astro build --mode pre",
        "preview": "astro preview",
        "astro": "astro",
        "typecheck": "astro check",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "husky",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm i18n:check",
        "indexnow": "node scripts/indexnow.ts",
        "i18n:check": "node scripts/check-i18n.ts"
    },
    "dependencies": {
        "@fontsource/inter": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "astro": "^7.4.4",
        "satori": "^0.63.2",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@astrojs/ts-plugin": "^1.10.12",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@commitlint/types": "^21.2.3",
        "@eslint/js": "^10.0.1",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
        "@types/node": "^22.20.5",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-jsx-a11y-x": "^0.2.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.6.0",
        "prettier": "3.9.10",
        "prettier-plugin-astro": "0.14.1",
        "prettier-plugin-tailwindcss": "0.8.1",
        "schema-dts": "^2.1.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "lint-staged": {
        "*.{astro,ts}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{md,json,yaml,yml,css}": [
            "prettier --write"
        ]
    }
}
