---
import "@styles/global.css";
import { Font } from "astro:assets";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import Seo, { type Props as SeoProps } from "@components/seo/Seo.astro";
import { AUTHOR, LOCALE_META, SITE } from "@constants/site.constants.ts";

type Props = SeoProps;

const { locale, alternates } = Astro.props;
---

<!doctype html>
<html lang={LOCALE_META[locale].lang}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <script is:inline>
            // Before the first paint, to avoid a flash of the wrong theme: the stored choice, else the system preference
            (() => {
                let theme;
                try {
                    theme = localStorage.getItem("theme");
                } catch {
                    // Storage can be blocked; fall back to the system preference
                }
                if (theme !== "light" && theme !== "dark") {
                    theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
                }
                document.documentElement.dataset.theme = theme;
            })();
        </script>
        <Font cssVariable="--font-archivo" preload={[{ style: "normal", subset: "latin" }]} />
        <Font cssVariable="--font-jetbrains-mono" />
        <Seo {...Astro.props} />
        <meta name="theme-color" content={SITE.themeColor} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/manifest.webmanifest" />
        {AUTHOR.sameAs.map((profile) => <link rel="me" href={profile} />)}
        <meta name="generator" content={Astro.generator} />
    </head>
    <body>
        <header>
            <LanguageSwitcher locale={locale} alternates={alternates} />
        </header>
        <slot />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: 100%;
    }
</style>
