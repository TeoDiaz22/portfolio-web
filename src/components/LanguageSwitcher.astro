---
/**
 * Links to the current page in every locale it exists in; the slug may differ per locale (`/sobre-mi` ↔ `/en/about`).
 * Renders nothing when the page has a single locale.
 */
import { LOCALE_META, LOCALES, type Locale } from "@constants/site.constants.ts";
import type { Alternates } from "@utils/content.utils.ts";
import { useTranslations } from "@utils/i18n.utils.ts";

interface Props {
    locale: Locale;
    alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const t = useTranslations(locale);
const links = LOCALES.flatMap((target) => {
    const href = alternates[target];
    return href ? [{ locale: target, href, lang: LOCALE_META[target].lang, name: LOCALE_META[target].name }] : [];
});
---

{
    links.length > 1 && (
        <nav aria-label={t("language.label")}>
            <ul class="cd-seg">
                {links.map((link) => (
                    <li>
                        <a
                            class="cd-seg-option"
                            href={link.href}
                            hreflang={link.lang}
                            lang={link.lang}
                            aria-current={link.locale === locale ? "page" : undefined}
                        >
                            {link.name}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}
