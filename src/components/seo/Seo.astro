---
/**
 * Every SEO tag of a page: title, description, canonical, robots, hreflang, Open Graph, Twitter Card and JSON-LD.
 * Rendered once by `Layout.astro`; pages only pass their `seo` data from a content collection.
 */
import { getImage } from "astro:assets";
import { BING_SITE_VERIFICATION, GOOGLE_SITE_VERIFICATION } from "astro:env/server";
import type { Thing } from "schema-dts";
import { DEFAULT_LOCALE, LOCALE_META, LOCALES, SITE, type Locale } from "@constants/site.constants.ts";
import type { Alternates } from "@utils/content.utils.ts";
import { isIndexable } from "@utils/env.utils.ts";
import { localizePath, useTranslations } from "@utils/i18n.utils.ts";
import { pageGraph, serializeJsonLd } from "@utils/schema.utils.ts";
import { absoluteUrl, markdownPath, ogImagePath, toPublicPath } from "@utils/url.utils.ts";
import type { SeoData } from "../../content.config.ts";

export interface Props {
    seo: SeoData;
    locale: Locale;
    /** Path of this page in each locale it exists in (including the current one), for `hreflang`. */
    alternates: Alternates;
    /**
     * Trail after the home page, for nested pages (e.g. projects → project). Defaults to the current page alone.
     * Paths are public paths in the current locale (`/proyectos`, `/en/projects`).
     */
    breadcrumbs?: { name: string; path: string }[];
    /** Extra JSON-LD nodes for this page (e.g. a project as `CreativeWork`). */
    jsonLd?: Thing[];
}

const { seo, locale, alternates: alternatePaths, breadcrumbs, jsonLd } = Astro.props;
const site = absoluteUrl("/", Astro.site);

const path = toPublicPath(Astro.url.pathname);
const title = seo.fullTitle ? seo.title : SITE.titleTemplate.replace("%s", seo.title);
const canonical = seo.canonical ?? absoluteUrl(path, Astro.site);
const robots =
    isIndexable && !seo.noindex
        ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        : "noindex, nofollow";
const alternates = LOCALES.flatMap((alternate) => {
    const alternatePath = alternatePaths[alternate];
    return alternatePath ? [{ locale: alternate, url: absoluteUrl(alternatePath, Astro.site) }] : [];
});
const defaultAlternate = alternates.find((alternate) => alternate.locale === DEFAULT_LOCALE);

// `seo.image` is resized to the Open Graph size; without it, the image generated at build time is used
const ogImageSrc = seo.image
    ? (await getImage({ src: seo.image, width: 1200, height: 630, fit: "cover", format: "jpg" })).src
    : ogImagePath(path);
const ogImageUrl = absoluteUrl(ogImageSrc, Astro.site);
const ogImageAlt = seo.imageAlt ?? seo.title;

const t = useTranslations(locale);
const homePath = localizePath("/", locale);
const trail = breadcrumbs ?? (path === homePath ? [] : [{ name: seo.title, path }]);
const graph = pageGraph(
    site,
    {
        type: seo.pageType,
        url: canonical,
        title: seo.title,
        description: seo.description,
        locale,
        imageUrl: ogImageUrl,
        publishedAt: seo.publishedAt,
        updatedAt: seo.updatedAt,
        breadcrumbs: [
            { name: t("breadcrumb.home"), url: absoluteUrl(homePath, Astro.site) },
            ...trail.map((crumb) => ({ name: crumb.name, url: absoluteUrl(crumb.path, Astro.site) })),
        ],
    },
    jsonLd,
);
---

<title>{title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={robots} />

{
    // noindex pages (e.g. 404) may exist in a single locale and have no Markdown version (src/pages/[...path].md.ts)
    !seo.noindex && (
        <>
            {alternates.map((alternate) => (
                <link rel="alternate" hreflang={LOCALE_META[alternate.locale].lang} href={alternate.url} />
            ))}
            {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.url} />}
            <link rel="alternate" type="text/markdown" href={markdownPath(path)} />
        </>
    )
}

<meta property="og:type" content={seo.ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{
    alternates
        .filter((alternate) => alternate.locale !== locale)
        .map((alternate) => <meta property="og:locale:alternate" content={LOCALE_META[alternate.locale].ogLocale} />)
}
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
{seo.publishedAt && <meta property="article:published_time" content={seo.publishedAt.toISOString()} />}
{seo.updatedAt && <meta property="article:modified_time" content={seo.updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image:alt" content={ogImageAlt} />
{
    SITE.twitterHandle && (
        <>
            <meta name="twitter:site" content={SITE.twitterHandle} />
            <meta name="twitter:creator" content={SITE.twitterHandle} />
        </>
    )
}

{GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />}
{BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={BING_SITE_VERIFICATION} />}

<script is:inline type="application/ld+json" set:html={serializeJsonLd(graph)} />
